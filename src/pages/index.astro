---
// Redirecionamento instantâneo para o idioma do usuário.
// Não renderiza nenhuma tela intermediária.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bruno Bispo</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <script is:inline define:vars={{ base }}>
      (function () {
        try {
          var cookie = document.cookie.match(/(?:^|;\s*)lang=(en|pt-br)/);
          var chosen = cookie ? cookie[1] : null;
          if (!chosen) {
            var navLang = (navigator.languages && navigator.languages[0]) || navigator.language || '';
            chosen = navLang.toLowerCase().indexOf('pt') === 0 ? 'pt-br' : 'en';
          }
          var prefix = base ? base : '';
          window.location.replace(prefix + '/' + chosen + '/');
        } catch (e) {
          var fallback = base ? base : '';
          window.location.replace(fallback + '/pt-br/');
        }
      })();
    </script>
    <meta http-equiv="refresh" content={`0;url=${base ? base : ''}/pt-br/`} />
    <style>
      html, body {
        background: #0d141d;
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
      }
    </style>
  </head>
  <body></body>
</html>
