---
import { Icon } from 'astro-icon/components';
import { site, socials } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/${lang}/`;
const year = new Date().getFullYear();

const columns = [
  {
    title: t.nav.about,
    links: [
      { label: t.nav.about, href: `${home}#about` },
      { label: t.nav.work, href: `${home}#journey` },
      { label: t.nav.stack, href: `${home}#stack` },
    ],
  },
  {
    title: t.nav.projects,
    links: [
      { label: t.projects.openSource, href: `${home}#opensource` },
      { label: t.nav.resume, href: `${home}resume` },
      { label: t.nav.contact, href: `${home}#contact` },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__logo" href={home} aria-label={`${site.name} — home`}>
          <span class="footer__mark" aria-hidden="true">B</span>
          <span>{site.name}</span>
        </a>
        <p class="footer__tag">
          {lang === 'en'
            ? 'Software engineer building desktop apps, distributed backends and tools with a taste for detail.'
            : 'Engenheiro de software construindo apps desktop, backends distribuídos e ferramentas com gosto pelo detalhe.'}
        </p>
        <ul class="footer__socials">
          {socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label} data-magnetic="8">
                <Icon name={s.icon} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      {columns.map((col) => (
        <nav class="footer__col" aria-label={col.title}>
          <h3>{col.title}</h3>
          <ul>
            {col.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="footer__wordmark" aria-hidden="true">
      <span>BRUNO BISPO</span>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy mono">© {year} {site.fullName}. {t.footer.rights}</p>
      <p class="footer__built mono">{t.footer.builtWith}</p>
      <a class="footer__top-link" href="#top">
        <Icon name="lucide:arrow-up" />
        <span>{t.footer.backToTop}</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-top: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid var(--line-soft);
    overflow: hidden;
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 650;
    font-size: var(--step-1);
  }
  .footer__mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--grad);
    color: #fff;
    font-weight: 800;
  }
  .footer__tag {
    margin-top: 1rem;
    max-width: 42ch;
    color: var(--text-2);
    font-size: var(--step--1);
    line-height: 1.6;
  }
  .footer__socials {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: flex;
    gap: 0.5rem;
  }
  .footer__socials a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    color: var(--text-2);
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease), transform 0.4s var(--ease);
  }
  .footer__socials a:hover {
    color: var(--text);
    border-color: var(--ring);
    transform: translateY(-2px);
  }
  .footer__socials :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .footer__col h3 {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-3);
    font-weight: 600;
  }
  .footer__col ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer__col a {
    color: var(--text-2);
    font-size: var(--step--1);
    transition: color 0.3s var(--ease);
  }
  .footer__col a:hover {
    color: var(--text);
  }

  .footer__wordmark {
    display: block;
    line-height: 0.78;
    letter-spacing: -0.05em;
    font-weight: 800;
    font-size: min(12vw, 11rem);
    text-align: center;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px var(--line);
    margin-bottom: -0.06em;
    user-select: none;
  }
  .footer__wordmark span {
    color: transparent;
    background: linear-gradient(180deg, color-mix(in srgb, var(--text) 55%, transparent), transparent 85%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 1.5rem;
    padding: 1.4rem 0 2rem;
    border-top: 1px solid var(--line-soft);
    font-size: 0.72rem;
    color: var(--text-3);
  }
  .footer__built {
    max-width: 46ch;
    text-align: center;
  }
  .footer__copy,
  .footer__built {
    margin: 0;
  }
  .footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-2);
    transition: color 0.3s var(--ease);
  }
  .footer__top-link:hover {
    color: var(--text);
  }
  .footer__top-link :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }

  @media (max-width: 820px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
    .footer__built {
      text-align: left;
    }
  }
</style>
