---
import { Icon } from 'astro-icon/components';
import { site, socials } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const words = t.contact.title.split(' ');
const head = words.slice(0, -1).join(' ');
const tail = words[words.length - 1];
---

<section class="section contact" id="contact">
  <div class="container contact__inner">
    <span class="section-label" data-reveal>{t.contact.kicker}</span>

    <h2 class="contact__title" data-reveal>
      {head} <span class="serif gradient-text">{tail}</span>
    </h2>

    <p class="lead contact__lead" data-reveal>{t.contact.lead}</p>

    <div class="contact__actions" data-reveal>
      <button
        class="btn btn--solid contact__mail"
        type="button"
        data-copy={site.email}
        data-copy-done={t.contact.copied}
        data-magnetic="8"
      >
        <Icon name="lucide:mail" class="icon" />
        <span data-copy-label>{site.email}</span>
        <Icon name="lucide:copy" class="contact__copy-icon" />
      </button>

      <a class="btn" href={`mailto:${site.email}`} data-magnetic="8">
        <Icon name="lucide:send" class="icon" />
        <span>{lang === 'en' ? 'Write me' : 'Me escreva'}</span>
      </a>
    </div>

    <div class="contact__socials" data-reveal>
      <span class="contact__or mono">{t.contact.or}</span>
      <ul class="socials">
        {socials.map((s) => (
          <li>
            <a class="social" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label}>
              <Icon name={s.icon} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="contact__meta mono" data-reveal>
      <span><Icon name="lucide:map-pin" /> {site.location}</span>
      <span class="contact__clock"><Icon name="lucide:clock" /> <span data-clock>—</span> GMT-3</span>
    </div>
  </div>
</section>

<script>
  const el = document.querySelector('[data-clock]');
  if (el) {
    const tick = () => {
      const now = new Date();
      const fmt = new Intl.DateTimeFormat('pt-BR', {
        timeZone: 'America/Bahia',
        hour: '2-digit',
        minute: '2-digit',
      });
      el.textContent = fmt.format(now);
    };
    tick();
    window.setInterval(tick, 20000);
  }
</script>

<style>
  .contact__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }
  .contact__title {
    font-size: var(--step-4);
    letter-spacing: -0.045em;
    max-width: 20ch;
    line-height: 1.02;
    margin-top: 0.4rem;
  }
  .contact__title .serif {
    font-size: 1.06em;
  }
  .contact__lead {
    max-width: 52ch;
    margin-top: 0;
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 0.8rem;
  }
  .contact__mail {
    font-size: var(--step-0);
    padding: 0.9rem 1.5rem;
  }
  .contact__copy-icon {
    width: 0.95rem;
    height: 0.95rem;
    opacity: 0.7;
    margin-left: 0.15rem;
  }

  .contact__socials {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.6rem;
  }
  .contact__or {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.5rem;
  }
  .social {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--glass);
    color: var(--text-2);
    transition: transform 0.4s var(--ease), color 0.35s var(--ease), border-color 0.35s var(--ease), background 0.35s var(--ease);
  }
  .social:hover {
    transform: translateY(-3px);
    color: var(--text);
    border-color: var(--ring);
    background: var(--elev);
  }
  .social :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .contact__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.6rem;
    margin-top: 1.8rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line-soft);
    width: 100%;
    font-size: 0.78rem;
    color: var(--text-3);
  }
  .contact__meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .contact__meta :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }
  .contact__clock span[data-clock] {
    font-variant-numeric: tabular-nums;
    color: var(--text-2);
  }
</style>
