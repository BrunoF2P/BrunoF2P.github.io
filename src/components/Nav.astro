---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import { ui, languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/${lang}/`;
const links = [
  { href: `${home}#about`, label: t.nav.about },
  { href: `${home}#journey`, label: t.nav.work },
  { href: `${home}#stack`, label: t.nav.stack },
  { href: `${home}#projects`, label: t.nav.projects },
  { href: `${home}#contact`, label: t.nav.contact },
];

const pathWithoutBase = base && Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname;
const rest = pathWithoutBase.replace(/^\/(en|pt-br)/, '') || '/';
const other: Lang = lang === 'en' ? 'pt-br' : 'en';
const otherHref = `${base}/${other}${rest === '/' ? '/' : rest}`;
---

<header class="site-nav" data-nav>
  <nav class="nav__inner glass" aria-label="Primary">
    <a class="brand" href={home} aria-label={`${site.name} — home`}>
      <span class="brand__mark" aria-hidden="true">B</span>
      <span class="brand__name">{site.name}</span>
    </a>

    <ul class="nav__links">
      {links.map((link) => (
        <li><a href={link.href} data-nav-link data-magnetic="5">{link.label}</a></li>
      ))}
    </ul>

    <div class="nav__actions">
      <a class="nav__icon" href={otherHref} aria-label={t.nav.language} data-set-lang={other} title={languages[other]}>
        <span class="nav__lang mono">{other === 'en' ? 'EN' : 'PT'}</span>
      </a>

      <button class="nav__icon" type="button" data-theme-toggle aria-label={t.nav.theme} title={t.nav.theme}>
        <Icon name="lucide:sun" class="theme-icon theme-icon--sun" />
        <Icon name="lucide:moon" class="theme-icon theme-icon--moon" />
      </button>

      <a class="btn btn--solid nav__cta" href={`${home}resume`}>
        <span>{t.nav.resume}</span>
        <Icon name="lucide:arrow-up-right" class="icon" />
      </a>

      <button class="nav__icon nav__burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label={t.nav.menu}>
        <Icon name="lucide:menu" />
      </button>
    </div>
  </nav>

  <div class="mobile-menu" id="mobile-menu" data-menu>
    <ul class="mobile-menu__links">
      {links.map((link, i) => (
        <li style={`--i:${i}`}><a href={link.href}><span class="mono">0{i + 1}</span>{link.label}</a></li>
      ))}
    </ul>
    <div class="mobile-menu__actions">
      <a class="btn" href={`${home}resume`}>{t.nav.resume}<Icon name="lucide:arrow-up-right" class="icon" /></a>
      <a class="btn" href={otherHref}>{languages[other]}</a>
    </div>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: clamp(0.6rem, 1.6vw, 1.1rem) var(--pad);
    pointer-events: none;
  }
  .nav__inner {
    pointer-events: auto;
    max-width: var(--maxw);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.5rem 0.5rem 0.9rem;
    border-radius: var(--radius);
    background: transparent;
    border-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition: background 0.5s var(--ease), border-color 0.5s var(--ease), box-shadow 0.5s var(--ease),
      backdrop-filter 0.5s var(--ease);
  }
  .site-nav.is-scrolled .nav__inner {
    background: var(--glass-strong);
    border-color: var(--line);
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    box-shadow: 0 10px 40px -24px rgba(0, 0, 0, 0.6);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-xs);
    background: var(--grad);
    color: #fff;
    font-weight: 800;
    font-size: 1.05rem;
    box-shadow: 0 8px 24px -10px color-mix(in srgb, var(--accent) 80%, transparent);
  }
  .brand__name {
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__links a {
    position: relative;
    display: inline-block;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-xs);
    font-size: 0.9rem;
    color: var(--text-2);
    transition: color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.3rem;
    height: 1.5px;
    border-radius: 2px;
    background: var(--grad);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.45s var(--ease);
  }
  .nav__links a:hover,
  .nav__links a.is-current {
    color: var(--text);
  }
  .nav__links a:hover::after,
  .nav__links a.is-current::after {
    transform: scaleX(1);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .nav__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    color: var(--text-2);
    border: 1px solid transparent;
    transition: color 0.3s var(--ease), background 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .nav__icon:hover {
    color: var(--text);
    background: var(--glass);
    border-color: var(--line);
  }
  .nav__icon :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .nav__lang {
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .theme-icon {
    position: absolute;
    transition: opacity 0.35s var(--ease), transform 0.45s var(--ease);
  }
  :global(html[data-theme='dark']) .theme-icon--sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  :global(html[data-theme='dark']) .theme-icon--moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
  }
  :global(html[data-theme='light']) .theme-icon--sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.4);
  }
  :global(html[data-theme='light']) .theme-icon--moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  .nav__cta {
    padding: 0.55rem 1rem;
    font-size: 0.88rem;
  }
  .nav__burger {
    display: none;
  }

  .mobile-menu {
    display: none;
  }
  @media (max-width: 900px) {
    .nav__links,
    .nav__cta {
      display: none;
    }
    .nav__burger {
      display: grid;
    }
    .mobile-menu {
      pointer-events: auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2rem;
      position: fixed;
      inset: 0;
      z-index: 99;
      padding: 6rem var(--pad) 3rem;
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      backdrop-filter: blur(26px) saturate(150%);
      -webkit-backdrop-filter: blur(26px) saturate(150%);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.45s var(--ease), visibility 0.45s var(--ease);
    }
    .mobile-menu.is-open {
      opacity: 1;
      visibility: visible;
    }
    .mobile-menu__links {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .mobile-menu__links a {
      display: flex;
      align-items: baseline;
      gap: 0.8rem;
      font-size: var(--step-3);
      font-weight: 700;
      letter-spacing: -0.03em;
      padding: 0.4rem 0;
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
      transition-delay: calc(var(--i) * 60ms);
    }
    .mobile-menu.is-open .mobile-menu__links a {
      opacity: 1;
      transform: translateY(0);
    }
    .mobile-menu__links span {
      color: var(--text-3);
      font-size: 0.8rem;
    }
    .mobile-menu__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
    }
  }
</style>
