---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const en = lang === 'en';

const spotlight = {
  name: 'Hycore',
  href: 'https://github.com/BrunoF2P/HyCore-Launcher',
  stars: 10,
  license: 'MIT',
  desc: en
    ? 'An ultralight Hytale launcher written in Rust with Tauri — under 10 MB, with mod management, isolated profiles and four languages.'
    : 'Launcher de Hytale ultraleve escrito em Rust com Tauri — abaixo de 10 MB, com gestão de mods, perfis isolados e quatro idiomas.',
};

const repos = [
  { name: 'Imglyze', href: 'https://github.com/BrunoF2P/Imglyze', desc: en ? 'Batch image optimizer' : 'Otimizador de imagens em lote' },
  { name: 'quijava', href: 'https://github.com/BrunoF2P/quijava', desc: en ? 'Desktop quiz platform' : 'Plataforma desktop de quizzes' },
  { name: 'FluxBlocks', href: 'https://github.com/BrunoF2P/FluxBlocks', desc: en ? 'Modern Tetris in Java' : 'Tetris moderno em Java' },
  { name: 'cinema-tech-api', href: 'https://github.com/BrunoF2P/cinema-tech-api', desc: en ? 'REST API for cinema' : 'API REST de cinema' },
  { name: 'arandu-fibonacci-benchmarks', href: 'https://github.com/BrunoF2P/arandu-fibonacci-benchmarks', desc: en ? 'Rust vs C vs Arandu' : 'Rust vs C vs Arandu' },
];
---

<section class="section opensource" id="opensource">
  <div class="container">
    <div class="opensource__panel glass">
      <div class="opensource__intro">
        <span class="section-label" data-reveal>{t.os.kicker}</span>
        <h2 class="section-title" data-reveal>{t.os.title}</h2>
        <p class="lead" data-reveal>{t.os.lead}</p>

        <a class="btn btn--solid opensource__cta" href={site.github} target="_blank" rel="noopener noreferrer" data-magnetic="8" data-reveal>
          <Icon name="simple-icons:github" class="icon" />
          <span>{t.os.cta}</span>
        </a>
      </div>

      <div class="opensource__list">
        <a class="repo repo--spotlight" href={spotlight.href} target="_blank" rel="noopener noreferrer" data-reveal data-spotlight>
          <div class="repo__top">
            <span class="repo__name">{spotlight.name}</span>
            <span class="repo__stars mono">
              <Icon name="lucide:star" />
              {spotlight.stars} {t.os.stars}
            </span>
          </div>
          <p class="repo__desc">{spotlight.desc}</p>
          <div class="repo__foot">
            <span class="chip">{spotlight.license}</span>
            <span class="chip">Rust · Tauri</span>
            <Icon name="lucide:arrow-up-right" class="repo__arrow" />
          </div>
        </a>

        {repos.map((repo) => (
          <a class="repo" href={repo.href} target="_blank" rel="noopener noreferrer" data-reveal>
            <Icon name="simple-icons:github" class="repo__icon" />
            <span class="repo__name">{repo.name}</span>
            <span class="repo__desc repo__desc--inline">{repo.desc}</span>
            <Icon name="lucide:arrow-up-right" class="repo__arrow" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .opensource__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(1.6rem, 4vw, 3.2rem);
    position: relative;
    overflow: hidden;
  }
  .opensource__panel::before {
    content: '';
    position: absolute;
    top: -40%;
    left: -10%;
    width: 55%;
    height: 140%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent-2) 22%, transparent), transparent 65%);
    pointer-events: none;
  }
  .opensource__intro {
    position: relative;
    z-index: 1;
  }
  .opensource__cta {
    margin-top: 1.8rem;
  }

  .opensource__list {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .repo {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.95rem 1.1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-soft);
    background: color-mix(in srgb, var(--bg) 40%, transparent);
    transition: border-color 0.35s var(--ease), transform 0.4s var(--ease), background 0.35s var(--ease);
  }
  .repo:hover {
    border-color: var(--ring);
    transform: translateX(4px);
    background: var(--glass);
  }
  .repo--spotlight {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--line));
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    padding: 1.3rem 1.3rem 1.4rem;
  }
  .repo--spotlight::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
    background: radial-gradient(300px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--accent) 20%, transparent), transparent 60%);
  }
  .repo--spotlight:hover::after {
    opacity: 1;
  }
  .repo__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .repo__name {
    font-weight: 650;
    letter-spacing: -0.02em;
    font-size: var(--step-1);
  }
  .repo--spotlight .repo__name {
    font-size: var(--step-2);
  }
  .repo__stars {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--text-2);
    white-space: nowrap;
  }
  .repo__stars :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
    color: #ffd60a;
  }
  .repo__desc {
    font-size: var(--step--1);
    color: var(--text-2);
    line-height: 1.55;
  }
  .repo__desc--inline {
    flex: 1;
    font-size: 0.78rem;
    color: var(--text-3);
  }
  .repo:not(.repo--spotlight) {
    flex-direction: row;
    align-items: center;
    gap: 0.8rem;
  }
  .repo__icon {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--text-3);
    flex-shrink: 0;
  }
  .repo:not(.repo--spotlight) .repo__name {
    font-size: var(--step-0);
    white-space: nowrap;
  }
  .repo__foot {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.3rem;
  }
  .repo__arrow {
    position: absolute;
    right: 1.1rem;
    bottom: 1.1rem;
    width: 1rem;
    height: 1rem;
    color: var(--text-3);
    transition: transform 0.35s var(--ease), color 0.35s var(--ease);
  }
  .repo:not(.repo--spotlight) .repo__arrow {
    position: static;
    flex-shrink: 0;
  }
  .repo:hover .repo__arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }
  .repo--spotlight .repo__foot {
    margin-right: 1.5rem;
  }

  @media (max-width: 900px) {
    .opensource__panel {
      grid-template-columns: 1fr;
    }
    .repo:not(.repo--spotlight) .repo__desc--inline {
      display: none;
    }
  }
</style>
