---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { projects, experiments, categories } from '../data/projects';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const accessLabel: Record<string, string> = {
  open: t.projects.openSource,
  private: t.projects.private,
  research: t.projects.research,
};
const accessIcon: Record<string, string> = {
  open: 'lucide:git-branch',
  private: 'lucide:lock',
  research: 'lucide:flask-conical',
};
const linkIcon: Record<string, string> = {
  code: 'lucide:code',
  live: 'lucide:external-link',
  case: 'lucide:file-text',
};
const linkLabel: Record<string, string> = {
  code: t.projects.viewCode,
  live: t.projects.viewLive,
  case: t.projects.viewCase,
};

const count = (c: string) => (c === 'all' ? projects.length : projects.filter((p) => p.category === c).length);

let featuredIndex = 0;
---

<section class="section projects" id="projects">
  <div class="container">
    <header class="projects__head">
      <div>
        <span class="section-label" data-reveal>{t.projects.kicker}</span>
        <h2 class="section-title" data-reveal>{t.projects.title}</h2>
      </div>
      <p class="lead projects__lead" data-reveal>{t.projects.lead}</p>
    </header>

    <div class="filters" data-filters="#projects-grid" role="group" aria-label={t.projects.title} data-reveal>
      <button type="button" class="filter" data-filter="all" aria-pressed="true">
        {t.projects.filters.all}<span class="filter__count mono">{count('all')}</span>
      </button>
      {categories.map((c) => (
        <button type="button" class="filter" data-filter={c} aria-pressed="false">
          {t.projects.filters[c]}<span class="filter__count mono">{count(c)}</span>
        </button>
      ))}
    </div>

    <div class="projects__grid" id="projects-grid">
      {projects.map((p) => {
        const featured = Boolean(p.featured);
        const flip = featured && featuredIndex++ % 2 === 1;
        return (
          <article
            class={`card glass ${featured ? 'card--featured' : ''} ${flip ? 'card--flip' : ''}`}
            data-reveal
            data-spotlight
            data-category={p.category}
            style={`--c1:${p.accent[0]};--c2:${p.accent[1]}`}
          >
            <div class="card__media">
              {p.cover ? (
                <>
                  <Image
                    src={p.cover}
                    alt={`${p.title} — project cover`}
                    widths={[480, 820, 1200]}
                    sizes="(max-width: 900px) 92vw, 46vw"
                    quality={82}
                    loading="lazy"
                    class="card__img"
                  />
                  {p.gallery?.[0] && (
                    <Image
                      src={p.gallery[0]}
                      alt={`${p.title} — second view`}
                      widths={[480, 820, 1200]}
                      sizes="(max-width: 900px) 92vw, 46vw"
                      quality={82}
                      loading="lazy"
                      class="card__img card__img--reveal"
                    />
                  )}
                </>
              ) : (
                <div class="card__fallback" aria-hidden="true">
                  <span class="card__fallback-mark">{p.title}</span>
                  <span class="card__fallback-grid"></span>
                </div>
              )}
              <span class="card__access mono">
                <Icon name={accessIcon[p.access]} />
                {accessLabel[p.access]}
              </span>
            </div>

            <div class="card__body">
              <div class="card__meta mono">
                <span>{p.year}</span>
                <span class="card__dot" aria-hidden="true"></span>
                <span>{t.projects.filters[p.category]}</span>
              </div>

              <h3 class="card__title">{p.title}</h3>
              <p class="card__tagline">{p.tagline[lang]}</p>
              <p class="card__summary">{p.summary[lang]}</p>

              {featured && (
                <ul class="card__highlights">
                  {p.highlights[lang].map((h) => (
                    <li>
                      <Icon name="lucide:chevron-right" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              )}

              <ul class="card__stack">
                {p.stack.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>

              {p.links && p.links.length > 0 ? (
                <div class="card__links">
                  {p.links.map((l) => (
                    <a class="card__link" href={l.href} target="_blank" rel="noopener noreferrer">
                      <Icon name={linkIcon[l.type]} />
                      <span>{linkLabel[l.type]}</span>
                      <Icon name="lucide:arrow-up-right" class="card__link-arrow" />
                    </a>
                  ))}
                </div>
              ) : (
                <div class="card__links">
                  <span class="card__link card__link--muted">
                    <Icon name="lucide:lock" />
                    <span>{t.projects.viewCase}</span>
                  </span>
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>

    <div class="experiments" data-reveal>
      <h3 class="experiments__title">{t.projects.more}</h3>
      <ul class="experiments__list">
        {experiments.map((e) => (
          <li>
            {e.href ? (
              <a href={e.href} target="_blank" rel="noopener noreferrer">
                <span class="experiments__name">{e.title}</span>
                <span class="experiments__note">{e.note[lang]}</span>
                <Icon name="lucide:arrow-up-right" />
              </a>
            ) : (
              <span class="experiments__row">
                <span class="experiments__name">{e.title}</span>
                <span class="experiments__note">{e.note[lang]}</span>
                <Icon name="lucide:lock" />
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .projects__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem 3rem;
    align-items: end;
    margin-bottom: 1.8rem;
  }
  .projects__lead {
    margin-top: 0;
    justify-self: end;
    max-width: 46ch;
    font-size: var(--step-0);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--glass);
    color: var(--text-2);
    font-size: var(--step--1);
    font-weight: 550;
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .filter:hover {
    color: var(--text);
    border-color: var(--ring);
  }
  .filter[aria-pressed='true'] {
    color: #fff;
    border-color: transparent;
    background: var(--grad);
  }
  .filter__count {
    font-size: 0.72rem;
    opacity: 0.65;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    border-radius: var(--radius);
    transition: transform 0.55s var(--ease), border-color 0.45s var(--ease);
  }
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.45s var(--ease);
    background: radial-gradient(340px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--c1) 22%, transparent), transparent 62%);
    z-index: 3;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--c1) 40%, var(--line));
  }
  .card:hover::after {
    opacity: 1;
  }
  .card.is-hidden {
    display: none;
  }

  .card--featured {
    grid-column: 1 / -1;
    flex-direction: row;
  }
  .card--featured .card__media {
    flex: 1 1 50%;
    aspect-ratio: auto;
    min-height: 100%;
  }
  .card--featured .card__body {
    flex: 1 1 48%;
    padding: clamp(1.4rem, 3vw, 2.6rem);
  }
  .card--featured.card--flip {
    flex-direction: row-reverse;
  }

  .card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background:
      radial-gradient(120% 120% at 18% 0%, color-mix(in srgb, var(--c1) 24%, transparent), transparent 58%),
      radial-gradient(120% 120% at 85% 100%, color-mix(in srgb, var(--c2) 22%, transparent), transparent 60%),
      var(--elev);
  }
  .card__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: clamp(0.9rem, 3vw, 1.8rem);
    transition: transform 0.8s var(--ease), filter 0.5s var(--ease);
  }
  .card--featured .card__img {
    padding: clamp(1.1rem, 2.8vw, 2.4rem);
  }
  .card:hover .card__img {
    transform: scale(1.045);
  }
  .card__img--reveal {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: none;
    transition: opacity 0.55s var(--ease);
  }
  .card:hover .card__img--reveal {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .card__img--reveal {
      display: none;
    }
  }
  .card__fallback {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 25% 20%, color-mix(in srgb, var(--c1) 55%, transparent), transparent 60%),
      radial-gradient(circle at 80% 80%, color-mix(in srgb, var(--c2) 55%, transparent), transparent 60%), var(--elev);
    overflow: hidden;
  }
  .card__fallback-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, var(--line-soft) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line-soft) 1px, transparent 1px);
    background-size: 42px 42px;
    opacity: 0.7;
  }
  .card__fallback-mark {
    position: relative;
    z-index: 1;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-3);
    color: var(--text);
    text-shadow: 0 6px 30px rgba(0, 0, 0, 0.4);
    transition: transform 0.7s var(--ease);
  }
  .card:hover .card__fallback-mark {
    transform: scale(1.04);
  }

  .card__access {
    position: absolute;
    left: 0.85rem;
    top: 0.85rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: var(--glass-strong);
    border: 1px solid var(--line);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .card__access :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.3rem 1.35rem 1.5rem;
    position: relative;
    z-index: 2;
  }
  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .card__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-3);
  }
  .card__title {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    line-height: 1.05;
    transition: color 0.4s var(--ease);
  }
  .card:hover .card__title {
    color: color-mix(in srgb, var(--c1) 70%, var(--text));
  }
  .card--featured .card__title {
    font-size: var(--step-3);
  }
  .card__tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--text);
    margin-top: -0.1rem;
  }
  .card__summary {
    font-size: var(--step--1);
    color: var(--text-2);
    line-height: 1.62;
    max-width: 62ch;
  }

  .card__highlights {
    list-style: none;
    margin: 0.5rem 0 0.2rem;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .card__highlights li {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    font-size: var(--step--1);
    color: var(--text-2);
    line-height: 1.5;
  }
  .card__highlights :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    margin-top: 0.28rem;
    flex-shrink: 0;
    color: var(--c1);
  }

  .card__stack {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line-soft);
  }
  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    font-weight: 550;
    color: var(--text-2);
    transition: color 0.3s var(--ease);
  }
  .card__link :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }
  .card__link:hover {
    color: var(--text);
  }
  .card__link-arrow {
    transition: transform 0.35s var(--ease);
  }
  .card__link:hover .card__link-arrow {
    transform: translate(2px, -2px);
  }
  .card__link--muted {
    opacity: 0.6;
  }

  .experiments {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.8rem;
    border-top: 1px solid var(--line-soft);
  }
  .experiments__title {
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 1rem;
  }
  .experiments__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.4rem 1.5rem;
  }
  .experiments__list a,
  .experiments__row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.5rem 0;
    border-bottom: 1px dashed var(--line-soft);
    transition: color 0.3s var(--ease);
  }
  .experiments__name {
    font-weight: 600;
    white-space: nowrap;
  }
  .experiments__note {
    font-size: var(--step--1);
    color: var(--text-3);
    flex: 1;
  }
  .experiments__list :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--text-3);
    flex-shrink: 0;
    transition: transform 0.3s var(--ease);
  }
  .experiments__list a:hover :global(svg) {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .projects__head {
      grid-template-columns: 1fr;
    }
    .projects__lead {
      justify-self: start;
    }
    .projects__grid {
      grid-template-columns: 1fr;
    }
    .card--featured,
    .card--featured.card--flip {
      flex-direction: column;
    }
    .card--featured .card__media {
      aspect-ratio: 16 / 10;
      flex: none;
      min-height: 0;
    }
  }
</style>
