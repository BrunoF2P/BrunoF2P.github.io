---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { projects, categories } from '../data/projects';
import { site } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const accessLabel: Record<string, string> = {
  open: t.projects.openSource,
  private: t.projects.private,
  research: t.projects.research,
};
const accessIcon: Record<string, string> = {
  open: 'lucide:git-branch',
  private: 'lucide:lock',
  research: 'lucide:flask-conical',
};
const linkIcon: Record<string, string> = {
  code: 'lucide:code',
  live: 'lucide:external-link',
  case: 'lucide:file-text',
};
const linkLabel: Record<string, string> = {
  code: t.projects.viewCode,
  live: t.projects.viewLive,
  case: t.projects.viewCase,
};

const count = (c: string) => (c === 'all' ? projects.length : projects.filter((p) => p.category === c).length);
const openCount = projects.filter((p) => p.access === 'open').length;

/** Highlighted work gets a full cinematic row; the rest fills a bento grid. */
const featured = projects.filter((p) => p.featured);
const archive = projects.filter((p) => !p.featured);
/** Bento rhythm — spans are chosen so every row closes cleanly on the 12-column grid. */
const RHYTHM = [7, 5, 5, 7, 6, 6, 8, 4];
const spans: number[] = [];
let cursor = 0;
archive.forEach((_, i) => {
  const want = RHYTHM[i % RHYTHM.length];
  const free = 12 - cursor;
  let span = want;
  if (i === archive.length - 1) span = free >= 4 ? free : 12; // closing tile fills the row
  else if (want > free && free >= 4) span = free; // small remainder: let the tile close it
  spans.push(span);
  cursor = span > free ? span % 12 : (cursor + span) % 12;
});
const ordinal = (n: number) => String(n).padStart(2, '0');
---

<section class="section projects" id="projects">
  <div class="container">
    <header class="projects__head">
      <div class="projects__headline">
        <span class="section-label" data-reveal>{t.projects.kicker}</span>
        <h2 class="section-title" data-split>{t.projects.title}</h2>
      </div>
      <div class="projects__intro">
        <p class="lead" data-reveal>{t.projects.lead}</p>
        <ul class="projects__stats mono" data-reveal>
          <li>
            <b data-count={String(projects.length)}>0</b><span>{t.projects.stats.projects}</span>
          </li>
          <li>
            <b data-count={String(categories.length)}>0</b><span>{t.projects.stats.areas}</span>
          </li>
          <li>
            <b data-count={String(openCount)}>0</b><span>{t.projects.stats.open}</span>
          </li>
        </ul>
      </div>
    </header>

    <div class="projects__controls">
      <div class="filters" data-filters="#projects-grid" role="group" aria-label={t.projects.title} data-reveal>
        <button type="button" class="filter" data-filter="all" aria-pressed="true">
          {t.projects.filters.all}<span class="filter__count mono">{count('all')}</span>
        </button>
        {categories.map((c) => (
          <button type="button" class="filter" data-filter={c} aria-pressed="false">
            {t.projects.filters[c]}<span class="filter__count mono">{count(c)}</span>
          </button>
        ))}
      </div>
      <p class="projects__showing mono" aria-live="polite">
        <b data-visible-count>{projects.length}</b>
        <span>/ {projects.length} {t.projects.count}</span>
      </p>
    </div>

    <div class="projects__grid" id="projects-grid">
      {
        featured.map((p, i) => (
          <article
            class={`scene glass spotlight ${i % 2 === 1 ? 'scene--flip' : ''}`}
            data-reveal
            data-spotlight
            data-category={p.category}
            style={`--c1:${p.accent[0]};--c2:${p.accent[1]};--spotlight-color:${p.accent[0]}`}
          >
            <div class="scene__visual">
              <div class="scene__shot" data-parallax="16">
                {p.cover ? (
                  <>
                    <Image
                      src={p.cover}
                      alt={`${p.title} — ${t.projects.viewLive}`}
                      widths={[560, 900, 1400]}
                      sizes="(max-width: 980px) 92vw, 46vw"
                      quality={84}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      class="scene__img"
                    />
                    {p.gallery?.[0] && (
                      <Image
                        src={p.gallery[0]}
                        alt=""
                        widths={[560, 900, 1400]}
                        sizes="(max-width: 980px) 92vw, 46vw"
                        quality={84}
                        loading="lazy"
                        class="scene__img scene__img--alt"
                      />
                    )}
                  </>
                ) : (
                  <div class="art" aria-hidden="true">
                    <span class="art__mark">{p.title}</span>
                  </div>
                )}
              </div>
              <span class="scene__ghost" aria-hidden="true">{ordinal(i + 1)}</span>
              <span class="access mono">
                <Icon name={accessIcon[p.access]} />
                {accessLabel[p.access]}
              </span>
            </div>

            <div class="scene__body">
              <div class="scene__topline mono">
                <span class="scene__no">{ordinal(i + 1)}</span>
                <span class="scene__rule" aria-hidden="true" />
                <span>
                  {p.year} · {t.projects.filters[p.category]}
                </span>
              </div>

              <h3 class="scene__title">{p.title}</h3>
              <p class="scene__tagline">{p.tagline[lang]}</p>
              <p class="scene__summary">{p.summary[lang]}</p>

              {p.highlights[lang].length > 0 && (
                <ul class="scene__highlights">
                  {p.highlights[lang].map((h) => (
                    <li>
                      <span class="scene__bullet" aria-hidden="true" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              )}

              <ul class="scene__stack">
                {p.stack.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>

              <div class="scene__links">
                {p.links && p.links.length > 0 ? (
                  p.links.map((l, li) => (
                    <a
                      class={`btn ${li === 0 ? 'btn--solid' : ''}`}
                      href={l.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-magnetic="8"
                    >
                      <Icon name={linkIcon[l.type]} class="icon" />
                      <span>{linkLabel[l.type]}</span>
                    </a>
                  ))
                ) : (
                  <span class="btn is-muted">
                    <Icon name="lucide:lock" class="icon" />
                    <span>{t.projects.viewCase}</span>
                  </span>
                )}
              </div>
            </div>
          </article>
        ))
      }

      {
        archive.map((p, i) => {
          const span = spans[i];
          const primary = p.links?.[0];
          return (
            <article
              class={`tile glass spotlight ${span >= 7 ? 'tile--wide' : ''}`}
              data-reveal
              data-spotlight
              data-tilt
              data-category={p.category}
              style={`--c1:${p.accent[0]};--c2:${p.accent[1]};--spotlight-color:${p.accent[0]};--span:${span}`}
            >
              <div class="tile__media" data-badge-zone>
                {primary ? (
                  <a
                    class="tile__hit"
                    href={primary.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${p.title} — ${linkLabel[primary.type]}`}
                  >
                    {p.cover ? (
                      <>
                        <Image
                          src={p.cover}
                          alt={`${p.title} — ${t.projects.viewLive}`}
                          widths={[480, 760, 1100]}
                          sizes="(max-width: 720px) 92vw, (max-width: 1100px) 46vw, 38vw"
                          quality={82}
                          loading="lazy"
                          class="tile__img"
                        />
                        {p.gallery?.[0] && (
                          <Image
                            src={p.gallery[0]}
                            alt=""
                            widths={[480, 760, 1100]}
                            sizes="(max-width: 720px) 92vw, (max-width: 1100px) 46vw, 38vw"
                            quality={82}
                            loading="lazy"
                            class="tile__img tile__img--alt"
                          />
                        )}
                      </>
                    ) : (
                      <div class="art" aria-hidden="true">
                        <span class="art__mark">{p.title}</span>
                      </div>
                    )}
                    <span class="tile__badge">
                      <span class="tile__badge-pill mono" data-badge-pill aria-hidden="true">
                        {t.projects.badge}
                        <Icon name="lucide:arrow-up-right" />
                      </span>
                    </span>
                  </a>
                ) : (
                  <div class="tile__hit">
                    {p.cover ? (
                      <>
                        <Image
                          src={p.cover}
                          alt={`${p.title} — ${t.projects.viewCase}`}
                          widths={[480, 760, 1100]}
                          sizes="(max-width: 720px) 92vw, (max-width: 1100px) 46vw, 38vw"
                          quality={82}
                          loading="lazy"
                          class="tile__img"
                        />
                        {p.gallery?.[0] && (
                          <Image
                            src={p.gallery[0]}
                            alt=""
                            widths={[480, 760, 1100]}
                            sizes="(max-width: 720px) 92vw, (max-width: 1100px) 46vw, 38vw"
                            quality={82}
                            loading="lazy"
                            class="tile__img tile__img--alt"
                          />
                        )}
                      </>
                    ) : (
                      <div class="art" aria-hidden="true">
                        <span class="art__mark">{p.title}</span>
                      </div>
                    )}
                  </div>
                )}
                <span class="access mono">
                  <Icon name={accessIcon[p.access]} />
                  {accessLabel[p.access]}
                </span>
              </div>

              <div class="tile__body">
                <span class="tile__meta mono">
                  {ordinal(featured.length + i + 1)} · {p.year} · {t.projects.filters[p.category]}
                </span>
                <h3 class="tile__title">{p.title}</h3>
                <p class="tile__tagline">{p.tagline[lang]}</p>
                <ul class="tile__stack">
                  {p.stack.slice(0, 4).map((s) => (
                    <li class="chip">{s}</li>
                  ))}
                </ul>
                <div class="tile__links">
                  {p.links && p.links.length > 0 ? (
                    p.links.map((l) => (
                      <a class="tile__link" href={l.href} target="_blank" rel="noopener noreferrer">
                        <Icon name={linkIcon[l.type]} />
                        <span>{linkLabel[l.type]}</span>
                      </a>
                    ))
                  ) : (
                    <span class="tile__link tile__link--muted">
                      <Icon name="lucide:lock" />
                      <span>{t.projects.viewCase}</span>
                    </span>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <aside class="projects__cta glass spotlight" data-reveal data-spotlight style="--spotlight-color:var(--accent-2)">
      <div class="projects__cta-text">
        <span class="section-label">{t.projects.cta.label}</span>
        <p class="projects__cta-title">{t.projects.cta.title}</p>
      </div>
      <a class="btn btn--solid" href={site.github} target="_blank" rel="noopener noreferrer" data-magnetic="10">
        <Icon name="simple-icons:github" class="icon" />
        <span>{t.projects.cta.action}</span>
      </a>
    </aside>
  </div>
</section>

<style>
  /* ---------- Header ---------- */
  .projects__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.6rem 3rem;
    align-items: end;
    margin-bottom: clamp(1.6rem, 3vw, 2.4rem);
  }
  .projects__intro {
    display: grid;
    gap: 1.1rem;
    justify-items: end;
  }
  .projects__intro .lead {
    margin-top: 0;
    max-width: 46ch;
    font-size: var(--step-0);
  }
  .projects__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.7rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .projects__stats li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
  }
  .projects__stats b {
    font-family: var(--font-sans);
    font-size: 1.5em;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .projects__stats span {
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* ---------- Floating filter bar ---------- */
  .projects__controls {
    position: sticky;
    top: 4.4rem;
    z-index: 30;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1.25rem;
    margin-bottom: clamp(1.4rem, 3vw, 2.2rem);
    padding: 0.55rem 0.65rem;
    border-radius: var(--radius);
    border: 1px solid var(--line-soft);
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    box-shadow: 0 18px 40px -30px rgba(0, 0, 0, 0.75);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.85rem;
    border-radius: var(--radius-xs);
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-2);
    font-size: var(--step--1);
    font-weight: 550;
    transition:
      color 0.3s var(--ease),
      background 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .filter:hover {
    color: var(--text);
    background: var(--elev);
  }
  .filter[aria-pressed='true'] {
    color: #fff;
    background: var(--grad);
  }
  .filter__count {
    font-size: 0.7rem;
    opacity: 0.6;
  }
  .projects__showing {
    margin: 0;
    padding-right: 0.5rem;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .projects__showing b {
    font-size: 1.3em;
    color: var(--text);
  }

  /* ---------- Grid ---------- */
  .projects__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(0.85rem, 1.4vw, 1.25rem);
  }
  /* A filtered subset drops the mosaic for a calm, uniform rhythm. */
  .projects__grid.is-filtered .tile {
    grid-column: span 6;
  }
  .scene.is-hidden,
  .tile.is-hidden {
    display: none;
  }

  /* ---------- Featured scenes ---------- */
  .scene {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    align-items: stretch;
    overflow: hidden;
    border-radius: calc(var(--radius) * 1.4);
    padding: 0;
    box-shadow: var(--glow);
    transition: border-color 0.5s var(--ease);
  }
  .scene::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      140deg,
      color-mix(in srgb, var(--c1) 72%, transparent),
      transparent 44%,
      color-mix(in srgb, var(--c2) 62%, transparent)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.4;
    transition: opacity 0.5s var(--ease);
    pointer-events: none;
  }
  .scene:hover::before {
    opacity: 1;
  }
  .scene--flip .scene__visual {
    order: 2;
  }
  .scene--flip .scene__body {
    order: 1;
  }

  .scene__visual {
    position: relative;
    overflow: hidden;
    min-height: clamp(17rem, 34vw, 30rem);
    background:
      radial-gradient(120% 120% at 18% 6%, color-mix(in srgb, var(--c1) 26%, transparent), transparent 58%),
      radial-gradient(120% 120% at 86% 100%, color-mix(in srgb, var(--c2) 24%, transparent), transparent 62%),
      var(--elev);
  }
  .scene__shot {
    position: absolute;
    inset: -8% 0;
  }
  .scene__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: clamp(1.1rem, 3vw, 2.4rem);
    transition:
      transform 0.9s var(--ease),
      opacity 0.6s var(--ease);
  }
  .scene__img--alt {
    opacity: 0;
  }
  .scene:hover .scene__img {
    transform: scale(1.045);
  }
  .scene:hover .scene__img--alt {
    opacity: 1;
  }
  .scene__ghost {
    position: absolute;
    left: clamp(0.6rem, 2vw, 1.6rem);
    bottom: clamp(0.55rem, 1.6vw, 1.15rem);
    z-index: 2;
    font-family: var(--font-serif);
    font-size: clamp(4.2rem, 11vw, 9rem);
    line-height: 0.78;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--c1) 62%, transparent);
    opacity: 0.55;
    pointer-events: none;
    transition:
      opacity 0.5s var(--ease),
      transform 0.8s var(--ease);
  }
  .scene:hover .scene__ghost {
    opacity: 0.95;
    transform: translateY(-8px);
  }

  .scene__body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: clamp(1.3rem, 2.6vw, 2.6rem);
  }
  .scene__topline {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .scene__no {
    color: color-mix(in srgb, var(--c1) 78%, var(--text));
  }
  .scene__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--line), transparent);
  }
  .scene__title {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .scene__tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--text);
    max-width: 40ch;
  }
  .scene__summary {
    font-size: var(--step--1);
    color: var(--text-2);
    line-height: 1.68;
    max-width: 58ch;
  }
  .scene__highlights {
    list-style: none;
    margin: 0.2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .scene__highlights li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: var(--step--1);
    color: var(--text-2);
    line-height: 1.5;
  }
  .scene__bullet {
    width: 6px;
    height: 6px;
    margin-top: 0.5rem;
    flex-shrink: 0;
    border-radius: 2px;
    background: var(--grad);
  }
  .scene__stack {
    list-style: none;
    margin: 0.3rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .scene__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 1.1rem;
  }
  .scene__links .btn {
    padding: 0.6rem 1.1rem;
    font-size: var(--step--1);
  }
  .scene__links .btn .icon {
    width: 0.95rem;
    height: 0.95rem;
  }
  .is-muted {
    opacity: 0.6;
  }

  /* ---------- Archive tiles ---------- */
  .tile {
    grid-column: span var(--span, 6);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    transition: border-color 0.45s var(--ease);
  }
  .tile:hover {
    border-color: color-mix(in srgb, var(--c1) 42%, var(--line));
  }
  .tile--wide {
    flex-direction: row;
    align-items: stretch;
  }
  .tile--wide .tile__media {
    flex: 1 1 46%;
    aspect-ratio: auto;
    min-height: clamp(12rem, 20vw, 17rem);
  }
  .tile--wide .tile__body {
    flex: 1 1 54%;
  }

  .tile__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background:
      radial-gradient(110% 110% at 16% 4%, color-mix(in srgb, var(--c1) 22%, transparent), transparent 60%),
      radial-gradient(110% 110% at 88% 100%, color-mix(in srgb, var(--c2) 20%, transparent), transparent 62%),
      var(--elev);
  }
  .tile__hit {
    position: absolute;
    inset: 0;
    display: block;
  }
  .tile__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: clamp(0.9rem, 2.6vw, 1.7rem);
    transition:
      transform 0.85s var(--ease),
      opacity 0.55s var(--ease);
  }
  .tile__img--alt {
    opacity: 0;
  }
  .tile:hover .tile__img {
    transform: scale(1.05);
  }
  .tile:hover .tile__img--alt {
    opacity: 1;
  }

  .tile__badge {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 4;
    pointer-events: none;
    will-change: transform;
  }
  .tile__badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-xs);
    background: color-mix(in srgb, var(--c1) 72%, #10151d);
    color: #fff;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: scale(0.4);
    box-shadow: 0 12px 30px -14px rgba(0, 0, 0, 0.75);
  }
  .tile__badge-pill :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
  }
  /* Touch / reduced-motion fallback: the pill is centred and shown on hover or focus. */
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .tile__badge {
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
    }
    .tile:hover .tile__badge-pill,
    .tile__hit:focus-visible .tile__badge-pill {
      opacity: 1;
      transform: none;
    }
  }

  .tile__body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.1rem 1.2rem 1.25rem;
  }
  .tile__meta {
