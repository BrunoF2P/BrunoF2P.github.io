---
import { Icon } from 'astro-icon/components';
import { site, socials } from '../data/site';
import { timeline } from '../data/experience';
import { stack } from '../data/stack';
import { projects } from '../data/projects';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const r = t.resumePage;
const en = lang === 'en';

const summary = en
  ? 'Software Engineering student at UNEB with practical experience in systems engineering and full-cycle development: high-performance Rust applications, Tauri desktop software, scalable edge architectures on Cloudflare, and backend services with Spring Boot and Go. Passionate about compiler engineering, memory safety models and data precision — combining rigorous analytical discipline from corporate operations with modern software craftsmanship.'
  : 'Estudante de Engenharia de Software na UNEB com sólida prática em engenharia de sistemas e desenvolvimento de ponta a ponta: aplicações de alta performance em Rust, software desktop multiplataforma com Tauri, arquiteturas na borda com Cloudflare e microsserviços com Spring Boot e Go. Pesquisador em engenharia de compiladores e segurança de memória — unindo rigor analítico e controle de dados adquiridos no ambiente corporativo à construção de software moderno.';

const education = timeline.filter((i) => i.kind === 'education');
const experience = timeline.filter((i) => i.kind === 'experience');
const courses = timeline.filter((i) => i.kind === 'course');
const milestones = timeline.filter((i) => i.kind === 'milestone');

// Projetos mais representativos para o currículo ATS
const targetProjectIds = ['arandu-lang', 'moussee', 'imglyze', 'hycore', 'quijava'];
const resumeProjects = targetProjectIds
  .map((id) => projects.find((p) => p.id === id))
  .filter((p): p is (typeof projects)[number] => p !== undefined);

const contacts: Array<{ icon: string; label: string; href?: string }> = [
  { icon: 'lucide:mail', label: site.email, href: `mailto:${site.email}` },
  { icon: 'lucide:map-pin', label: site.location },
  { icon: 'simple-icons:github', label: 'github.com/BrunoF2P', href: site.github },
  { icon: 'simple-icons:linkedin', label: 'linkedin.com/in/brunof2p', href: site.linkedin },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article class="resume">
  <div class="container">
    <div class="resume__bar" data-reveal>
      <a class="resume__back" href={`${base}/${lang}/`}>
        <Icon name="lucide:arrow-left" />
        <span>{en ? 'Back to portfolio' : 'Voltar ao portfólio'}</span>
      </a>
      <div class="resume__bar-actions">
        <a class="btn btn--solid" href={en ? `${base}${site.resumeEn}` : `${base}${site.resume}`} download>
          <Icon name="lucide:download" class="icon" />
          <span>{r.download}</span>
        </a>
        <button class="btn" type="button" id="print-btn">
          <Icon name="lucide:printer" class="icon" />
          <span>{r.print}</span>
        </button>
      </div>
    </div>

    <header class="resume__head">
      <div>
        <h1 class="resume__name">{site.fullName}</h1>
        <p class="resume__role">
          {en ? 'Software Engineer & Computer Science Researcher' : 'Engenheiro de Software & Pesquisador'} · UNEB
        </p>
      </div>
      <ul class="resume__contacts">
        {contacts.map((c) => (
          <li>
            {c.href ? (
              <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
                <Icon name={c.icon} />
                <span>{c.label}</span>
              </a>
            ) : (
              <span>
                <Icon name={c.icon} />
                <span>{c.label}</span>
              </span>
            )}
          </li>
        ))}
      </ul>
    </header>

    <div class="resume__body">
      <div class="resume__main">
        <!-- Resumo Profissional / Professional Summary -->
        <section class="rblock">
          <h2 class="rblock__title">{r.summary}</h2>
          <p class="rblock__text">{summary}</p>
        </section>

        <!-- Experiência Profissional / Professional Experience -->
        <section class="rblock">
          <h2 class="rblock__title">{r.experience}</h2>
          {experience.map((item) => (
            <div class="rentry">
              <div class="rentry__head">
                <div>
                  <h3 class="rentry__title">{item.title[lang]}</h3>
                  <p class="rentry__org">
                    {item.org[lang]}
                    {item.location && <span class="rentry__loc"> · {item.location[lang]}</span>}
                  </p>
                </div>
                <span class="rentry__period mono">{item.period[lang]}</span>
              </div>
              <p class="rentry__desc">{item.desc[lang]}</p>
              {item.responsibilities && (
                <ul class="rentry__bullets">
                  {item.responsibilities.map((resp) => (
                    <li>
                      <strong>{resp.title[lang]}:</strong> {resp.desc[lang]}
                    </li>
                  ))}
                </ul>
              )}
              {item.tags && item.tags.length > 0 && (
                <div class="rentry__tags">
                  {item.tags.map((tag) => (
                    <span class="chip">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          ))}

          {milestones.map((item) => (
            <div class="rentry">
              <div class="rentry__head">
                <div>
                  <h3 class="rentry__title">{item.title[lang]}</h3>
                  <p class="rentry__org">
                    {item.org[lang]}
                    {item.location && <span class="rentry__loc"> · {item.location[lang]}</span>}
                  </p>
                </div>
                <span class="rentry__period mono">{item.period[lang]}</span>
              </div>
              <p class="rentry__desc">{item.desc[lang]}</p>
              {item.responsibilities && (
                <ul class="rentry__bullets">
                  {item.responsibilities.map((resp) => (
                    <li>
                      <strong>{resp.title[lang]}:</strong> {resp.desc[lang]}
                    </li>
                  ))}
                </ul>
              )}
              {item.tags && item.tags.length > 0 && (
                <div class="rentry__tags">
                  {item.tags.map((tag) => (
                    <span class="chip">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          ))}
        </section>

        <!-- Projetos Principais / Key Projects -->
        <section class="rblock">
          <h2 class="rblock__title">{r.projects}</h2>
          {resumeProjects.map((p) => (
            <div class="rentry rentry--project">
              <div class="rentry__head">
                <div>
                  <h3 class="rentry__title">{p.title}</h3>
                  <span class="rentry__tagline">{p.tagline[lang]}</span>
                </div>
                <span class="rentry__stack mono">{p.stack.slice(0, 5).join(' · ')}</span>
              </div>
              <p class="rentry__desc">{p.summary[lang]}</p>
              {p.highlights && p.highlights[lang] && (
                <ul class="rentry__bullets">
                  {p.highlights[lang].map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </section>
      </div>

      <aside class="resume__aside">
        <!-- Formação Acadêmica / Education -->
        <section class="rblock">
          <h2 class="rblock__title">{r.education}</h2>
          {education.map((item) => (
            <div class="rentry">
              <div class="rentry__head">
                <div>
                  <h3 class="rentry__title">{item.title[lang]}</h3>
                  <p class="rentry__org">{item.org[lang]}</p>
                </div>
                <span class="rentry__period mono">{item.period[lang]}</span>
              </div>
              <p class="rentry__desc">{item.desc[lang]}</p>
            </div>
          ))}
        </section>

        <!-- Habilidades Técnicas / Technical Skills -->
        <section class="rblock">
          <h2 class="rblock__title">{r.skills}</h2>
          <ul class="rskills">
            {stack.map((group) => (
              <li>
                <span class="rskills__label">{t.stack.groups[group.id]}</span>
                <span class="rskills__items">{group.items.map((i) => i.name).join(' · ')}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Cursos / Certifications & Courses -->
        <section class="rblock">
          <h2 class="rblock__title">{r.courses}</h2>
          {courses.map((item) => (
            <div class="rentry rentry--compact">
              <div class="rentry__head">
                <h3 class="rentry__title">{item.title[lang]}</h3>
                <span class="rentry__period mono">{item.period[lang]}</span>
              </div>
              <p class="rentry__org">{item.org[lang]}</p>
              {item.desc && <p class="rentry__desc">{item.desc[lang]}</p>}
            </div>
          ))}
        </section>

        <!-- Idiomas / Languages -->
        <section class="rblock">
          <h2 class="rblock__title">{r.languages}</h2>
          <ul class="rlangs">
            <li>
              <span>{en ? 'Portuguese' : 'Português'}</span>
              <span class="mono">{en ? 'Native' : 'Nativo'}</span>
            </li>
            <li>
              <span>{en ? 'English' : 'Inglês'}</span>
              <span class="mono">{en ? 'Technical proficiency (fluent reading)' : 'Leitura técnica fluente'}</span>
            </li>
          </ul>
        </section>

        <!-- Links e Redes / Links -->
        <section class="rblock screen-only">
          <h2 class="rblock__title">{r.contact}</h2>
          <ul class="rcontact">
            {socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  <Icon name={s.icon} />
                  <span>{s.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </aside>
    </div>
  </div>
</article>

<script>
  document.getElementById('print-btn')?.addEventListener('click', () => window.print());
</script>

<style>
  .resume {
    padding-top: clamp(2rem, 5vh, 3.5rem);
    padding-bottom: 4rem;
  }
  .resume__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .resume__bar-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .resume__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--step--1);
    color: var(--text-2);
    transition: color 0.3s var(--ease);
  }
  .resume__back:hover {
    color: var(--text);
  }
  .resume__back :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }

  .resume__head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1.5rem 2.5rem;
    align-items: end;
    padding-bottom: 1.8rem;
    border-bottom: 1px solid var(--line);
  }
  .resume__name {
    font-size: var(--step-4);
    letter-spacing: -0.045em;
    line-height: 1.05;
  }
  .resume__role {
    margin-top: 0.5rem;
    color: var(--text-2);
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  .resume__contacts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.45rem 1rem;
    font-size: var(--step--1);
  }
  .resume__contacts a,
  .resume__contacts span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-2);
    transition: color 0.3s var(--ease);
  }
  .resume__contacts a:hover {
    color: var(--text);
  }
  .resume__contacts :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--text-3);
    flex-shrink: 0;
  }

  .resume__body {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding-top: clamp(1.6rem, 4vw, 2.6rem);
  }
  .resume__main,
  .resume__aside {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
  }

  .rblock {
    position: relative;
  }
  .rblock__title {
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
    font-weight: 700;
  }
  .rblock__text {
    color: var(--text-2);
    font-size: var(--step-0);
    line-height: 1.65;
    max-width: 70ch;
  }

  .rentry {
    padding-bottom: 1.3rem;
    margin-bottom: 1.3rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .rentry:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .rentry--compact {
    padding-bottom: 0.8rem;
    margin-bottom: 0.8rem;
  }
  .rentry__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
  }
  .rentry__title {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    font-weight: 650;
    line-height: 1.2;
  }
  .rentry__tagline {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--text-3);
    margin-top: 0.15rem;
  }
  .rentry__org {
    margin-top: 0.25rem;
    font-size: var(--step--1);
    color: var(--accent);
    font-weight: 550;
  }
  .rentry__loc {
    color: var(--text-3);
    font-weight: 400;
  }
  .rentry__period,
  .rentry__stack {
    font-size: 0.74rem;
    color: var(--text-3);
    white-space: nowrap;
  }
  .rentry__desc {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--text-2);
    line-height: 1.6;
  }
  .rentry__bullets {
    margin: 0.65rem 0 0;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: var(--step--1);
    color: var(--text-2);
    line-height: 1.55;
  }
  .rentry__bullets li::marker {
    color: var(--accent);
  }
  .rentry__bullets strong {
    color: var(--text);
    font-weight: 600;
  }
  .rentry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }

  .rskills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .rskills__label {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-3);
    margin-bottom: 0.25rem;
    font-weight: 600;
  }
  .rskills__items {
    font-size: var(--step--1);
    color: var(--text-2);
    line-height: 1.55;
  }

  .rlangs,
  .rcontact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: var(--step--1);
  }
  .rlangs li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    color: var(--text-2);
  }
  .rlangs .mono {
    color: var(--text-3);
    font-size: 0.74rem;
  }
  .rcontact a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-2);
    transition: color 0.3s var(--ease);
  }
  .rcontact a:hover {
    color: var(--text);
  }
  .rcontact :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--text-3);
  }

  @media (max-width: 900px) {
    .resume__head {
      grid-template-columns: 1fr;
    }
    .resume__body {
      grid-template-columns: 1fr;
    }
  }

  /* ============================================================
     PRINT STYLES — ATS Optimized & Clean A4 Flow
     ============================================================ */
  @media print {
    @page {
      size: A4;
      margin: 10mm 14mm 12mm;
    }

    .screen-only,
    .resume__bar,
    .skip-link {
      display: none !important;
    }

    .resume {
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }

    .container {
      max-width: none !important;
      padding-inline: 0 !important;
    }

    .resume__head {
      display: block !important;
      padding-bottom: 0.9rem !important;
      border-bottom: 1.5px solid #111 !important;
      margin-bottom: 1rem !important;
    }

    .resume__name {
      font-size: 1.85rem !important;
      color: #000 !important;
      font-weight: 700 !important;
      letter-spacing: -0.02em !important;
    }

    .resume__role {
      font-size: 0.95rem !important;
      color: #333 !important;
      font-weight: 600 !important;
      margin-top: 0.2rem !important;
    }

    .resume__contacts {
      display: flex !important;
      flex-wrap: wrap !important;
      gap: 0.4rem 1.2rem !important;
      margin-top: 0.5rem !important;
      font-size: 0.8rem !important;
      color: #333 !important;
    }
    .resume__contacts a,
    .resume__contacts span {
      color: #222 !important;
      text-decoration: none !important;
    }
    .resume__contacts :global(svg) {
      display: none !important;
    }

    /* Em impressão, um layout corrido e sem quebras estranhas */
    .resume__body {
      display: block !important;
      padding-top: 0.4rem !important;
    }

    .resume__main,
    .resume__aside {
      display: block !important;
      gap: 0 !important;
    }

    .rblock {
      break-inside: auto;
      page-break-inside: auto;
      margin-bottom: 1.2rem !important;
    }

    .rblock__title {
      font-size: 0.82rem !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
      color: #000 !important;
      border-bottom: 1px solid #ccc !important;
      padding-bottom: 0.25rem !important;
      margin-bottom: 0.6rem !important;
      font-weight: 700 !important;
      break-after: avoid;
      page-break-after: avoid;
    }

    .rblock__text {
      font-size: 0.84rem !important;
      line-height: 1.45 !important;
      color: #222 !important;
      max-width: none !important;
    }

    .rentry {
      break-inside: avoid !important;
      page-break-inside: avoid !important;
      padding-bottom: 0.75rem !important;
      margin-bottom: 0.75rem !important;
      border-bottom: 1px dashed #e2e2e5 !important;
    }
    .rentry:last-child {
      border-bottom: none !important;
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
    }

    .rentry__head {
      display: flex !important;
      justify-content: space-between !important;
      align-items: baseline !important;
      margin-bottom: 0.2rem !important;
    }

    .rentry__title {
      font-size: 0.95rem !important;
      color: #000 !important;
      font-weight: 700 !important;
    }

    .rentry__org {
      font-size: 0.82rem !important;
      color: #333 !important;
      font-weight: 600 !important;
      margin-top: 0.1rem !important;
    }

    .rentry__loc {
      color: #555 !important;
      font-weight: 400 !important;
    }

    .rentry__period,
    .rentry__stack {
      font-size: 0.76rem !important;
      color: #444 !important;
      font-weight: 500 !important;
    }

    .rentry__tagline {
      font-size: 0.8rem !important;
      color: #555 !important;
    }

    .rentry__desc {
      font-size: 0.82rem !important;
      line-height: 1.45 !important;
      color: #222 !important;
      margin-top: 0.25rem !important;
    }

    .rentry__bullets {
      margin-top: 0.35rem !important;
      padding-left: 1rem !important;
      gap: 0.25rem !important;
      font-size: 0.8rem !important;
      line-height: 1.4 !important;
      color: #222 !important;
    }
    .rentry__bullets li::marker {
      color: #444 !important;
    }
    .rentry__bullets strong {
      color: #000 !important;
      font-weight: 600 !important;
    }

    .rentry__tags {
      display: none !important;
    }

    .rskills {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 0.5rem 1.2rem !important;
    }
    .rskills__label {
      color: #000 !important;
      font-weight: 700 !important;
      font-size: 0.72rem !important;
    }
    .rskills__items {
      font-size: 0.8rem !important;
      color: #333 !important;
      line-height: 1.35 !important;
    }

    .rlangs {
      display: flex !important;
      flex-direction: row !important;
      gap: 1.5rem !important;
      font-size: 0.8rem !important;
    }
    .rlangs li {
      color: #222 !important;
      gap: 0.4rem !important;
    }
    .rlangs .mono {
      color: #555 !important;
    }
  }
</style>
