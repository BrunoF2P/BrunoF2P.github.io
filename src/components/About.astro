---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import profile from '../assets/profile.jpg';
import { site } from '../data/site';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const paragraphs = [t.about.p1, t.about.p2, t.about.p3];
---

<section class="section about" id="about">
  <div class="container">
    <div class="about__grid">
      <div class="about__body">
        <span class="section-label" data-reveal>{t.about.kicker}</span>
        <h2 class="section-title" data-split>{t.about.title}</h2>

        <div class="about__text" data-reveal-group>
          {paragraphs.map((p) => (
            <p data-reveal>{p}</p>
          ))}
        </div>

        <ul class="about__stats" data-reveal-group>
          {t.about.stats.map((stat) => (
            <li class="about__stat" data-reveal>
              <span class="about__stat-value" data-count={stat.value}>{stat.value}</span>
              <span class="about__stat-label">{stat.label}</span>
            </li>
          ))}
        </ul>
      </div>

      <aside class="about__aside" data-reveal>
        <figure class="portrait">
          <Image
            src={profile}
            alt={`${site.name} — portrait`}
            widths={[320, 480, 720]}
            sizes="(max-width: 900px) 70vw, 340px"
            quality={88}
            loading="lazy"
            class="portrait__img"
          />
          <div class="portrait__glow" aria-hidden="true"></div>
          <figcaption class="portrait__caption mono">
            <Icon name="lucide:map-pin" />
            {site.city}
          </figcaption>
        </figure>

        <div class="about__card glass">
          <span class="about__card-label mono">{lang === 'en' ? 'Currently' : 'Atualmente'}</span>
          <p class="about__card-text">
            {lang === 'en'
              ? 'Authoring the Arandu programming language (arandu-lang.dev) & advancing compiler memory safety research.'
              : 'Evoluindo a linguagem de programação Arandu (arandu-lang.dev) e pesquisando segurança de memória em compiladores.'}
          </p>
          <span class="about__card-sign serif">{site.fullName}</span>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-top: 1.6rem;
    max-width: 62ch;
  }
  .about__text p {
    color: var(--text-2);
    font-size: var(--step-0);
    line-height: 1.7;
  }
  .about__text p:first-child {
    color: var(--text);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .about__stats {
    list-style: none;
    margin: 2.6rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    border-top: 1px solid var(--line-soft);
    padding-top: 1.6rem;
  }
  .about__stat-value {
    display: block;
    font-size: var(--step-2);
    font-weight: 750;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .about__stat-label {
    display: block;
    margin-top: 0.3rem;
    font-size: var(--step--1);
    color: var(--text-3);
    line-height: 1.35;
  }

  .about__aside {
    position: sticky;
    top: 7rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .portrait {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    isolation: isolate;
  }
  .portrait__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(1.05) contrast(1.03);
  }
  .portrait__glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(200deg, transparent 40%, color-mix(in srgb, var(--bg) 85%, transparent));
    z-index: 1;
  }
  .portrait__caption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-xs);
    background: var(--glass-strong);
    border: 1px solid var(--line);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    font-size: 0.75rem;
    color: var(--text-2);
  }
  .portrait__caption :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
  }

  .about__card {
    padding: 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .about__card-label {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .about__card-text {
    font-size: var(--step--1);
    color: var(--text-2);
    line-height: 1.5;
  }
  .about__card-sign {
    font-size: 1.35rem;
    color: var(--text);
    margin-top: 0.2rem;
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__aside {
      position: static;
      max-width: 360px;
      margin-inline: auto;
      width: 100%;
    }
    .about__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.4rem 1rem;
    }
    .about__stat {
      text-align: center;
    }
  }

  @media (max-width: 640px) {
    .about__text p {
      text-align: justify;
      text-justify: inter-word;
      hyphens: auto;
      -webkit-hyphens: auto;
    }
  }

  @media (min-width: 1500px) {
    .about__grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.75fr);
      gap: clamp(3rem, 7vw, 8rem);
    }
    .about__text {
      max-width: 66ch;
    }
  }
</style>
